# ==========================================================
#  Portal de Demandas — configuração
#  Copie para ".env" e preencha. Nunca publique o .env.
# ==========================================================

# --- Servidor ---
PORTA=3000
URL_PUBLICA=https://demandas.lucasleoncine.com.br
# 1 se estiver atrás de Nginx/Caddy/Cloudflare (para ler o IP real do cidadão)
CONFIAR_PROXY=1
PASTA_DADOS=dados
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEGREDO_IP=troque-por-um-valor-aleatorio

# --- Painel do gabinete (login no navegador) ---
PAINEL_USUARIO=gabinete
PAINEL_SENHA=defina-uma-senha-forte

# --- Identificação ---
VEREADOR_NOME=Lucas Leoncine
VEREADOR_CARGO=Vereador
CAMARA_NOME=Câmara Municipal de Americana
CIDADE=Americana
UF=SP
PREFIXO_PROTOCOLO=LL
WHATSAPP_GABINETE=5519999845200

# --- Limites ---
LIMITE_ENVIOS_POR_IP=8
JANELA_LIMITE_MIN=15
FOTO_MAX_MB=10

# --- Sistema do gabinete (Webhook) ---
# Planilha Google: use a URL /exec do scripts/apps-script-gabinete.gs
GABINETE_WEBHOOK_URL=
GABINETE_WEBHOOK_SEGREDO=troque-por-um-valor-aleatorio
GABINETE_ENVIAR_FOTO_BASE64=0

# --- Documento de Indicação ---
INDICACAO_MODELO=templates/indicacao.docx
INDICACAO_GERAR_PDF=1
# 0 = o nome do munícipe NÃO aparece no documento público (recomendado pela LGPD)
INDICACAO_INCLUIR_NOME_MUNICIPE=0
PYTHON_BIN=python3
SOFFICE_BIN=soffice

# --- WhatsApp: meta | zapi | evolution | desligado ---
WHATSAPP_PROVEDOR=desligado
NOTIFICAR_MUDANCA_STATUS=1

# Meta (API oficial WhatsApp Cloud) — exige templates aprovados (docs/whatsapp-templates-meta.md)
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERSAO=v21.0
META_WA_IDIOMA=pt_BR
META_WA_TEMPLATE_CONFIRMACAO=confirmacao_demanda
META_WA_TEMPLATE_STATUS=atualizacao_demanda

# Z-API
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Evolution API (auto-hospedada)
EVOLUTION_URL=
EVOLUTION_INSTANCIA=
EVOLUTION_API_KEY=

# --- E-mail: brevo | resend | smtp | desligado ---
EMAIL_PROVEDOR=desligado
EMAIL_REMETENTE=gabinete@lucasleoncine.com.br
EMAIL_REMETENTE_NOME=Gabinete Vereador Lucas Leoncine
EMAIL_API_KEY=
# Só para EMAIL_PROVEDOR=smtp (requer: npm install nodemailer)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
# Recebe cada nova demanda com a Indicação em anexo (deixe vazio para desligar)
EMAIL_COPIA_GABINETE=
